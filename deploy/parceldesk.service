[Unit]
Description=ParcelDesk — multi-carrier parcel tracking (DHL / FedEx / Aramex)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parceldesk
Group=parceldesk
WorkingDirectory=/opt/parceltrack
EnvironmentFile=/opt/parceltrack/.env
ExecStart=/opt/parceltrack/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# gentle hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/parceltrack/data

[Install]
WantedBy=multi-user.target
