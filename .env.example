# ------------------------------------------------------------------
# ParcelDesk configuration — copy this file to .env and fill it in.
# Every value below is optional: leave a carrier blank and that carrier
# simply stays in manual mode.
# ------------------------------------------------------------------

# Branding / links
APP_NAME=ParcelDesk
COMPANY_NAME=My Company
PUBLIC_BASE_URL=http://localhost:8000

# First login (created automatically on first start — change it after login!)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123

# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Storage
DATABASE_URL=sqlite:///./data/parceltrack.db
# For PostgreSQL instead:  DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/parceltrack

# ---------------------------------------------------------------- tracking
# true  = simulated carrier data, no credentials needed (for trials/demo)
# false = real DHL / FedEx / Aramex APIs
DEMO_MODE=false
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=30
HTTP_TIMEOUT_SECONDS=20

# Alert thresholds
STUCK_CUSTOMS_DAYS=5
STUCK_TRANSIT_DAYS=14

# ------------------------------------------------------- DHL Express API
# https://developer.dhl.com  ->  "Shipment Tracking - Unified"
DHL_API_KEY=
DHL_API_SECRET=
DHL_USE_TEST=false

# --------------------------------------------------------------- FedEx API
# https://developer.fedex.com  ->  project with "Track API" access
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_USE_SANDBOX=false

# ------------------------------------------------------------------ Aramex
# Credentials issued by Aramex for Shipping API v2 access
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=MG

# ------------------------------------------------------- UPS API
# https://developer.ups.com  ->  OAuth client credentials + Track API
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_USE_TEST=false

# -------------------------------------------- DHL eCommerce / DHL Parcel
# Same developer.dhl.com account, product "Shipment Tracking - Unified"
# (the public tracking host; falls back to DHL_API_KEY when left empty)
DHL_ECOM_API_KEY=

# ------------------------------------------- Colissimo / La Poste (FR)
# Enterprise REST tracking: contract number + X-Okapi-Key
COLISSIMO_API_KEY=
COLISSIMO_CONTRACT_NUMBER=
COLISSIMO_PASSWORD=

# --------------------------------- 17TRACK aggregator (EMS, postal, 3000+)
# https://api.17track.net  ->  free tier available
TRACK17_API_KEY=

# ------------------------------------------------------------ email alerts
ALERTS_ENABLED=true
ALERT_ON_STATUSES=delivered,exception,customs,out_for_delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=parcels@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
DAILY_DIGEST_HOUR=7

# --------------------------------------------------- WhatsApp / SMS alerts
# Provider: whatsapp | twilio | webhook | none
MESSAGING_ENABLED=true
MESSAGING_PROVIDER=none
# Which statuses trigger a text (leave empty to reuse ALERT_ON_STATUSES)
MESSAGING_ALERT_STATUSES=
# Fallback numbers when a user/client has no phone on file (E.164, comma separated)
MESSAGING_RECIPIENTS=

# WhatsApp — Meta Cloud API (developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Twilio (SMS or WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_USE_WHATSAPP=false

# Generic HTTP gateway (Africa's Talking, Vonage, n8n, Zapier, your own bot):
# receives {"to": "+261...", "message": "..."} as JSON; optional bearer token.
WEBHOOK_URL=
WEBHOOK_TOKEN=
# Optional custom JSON body, {to} and {message} are substituted:
# WEBHOOK_PAYLOAD_TEMPLATE={"phone":"{to}","text":"{message}"}

# ------------------------------------------- warehouse, labels, last-mile polling
# Parcels on the shelf longer than this are flagged as ageing in Stock and in alerts.
# Can also be changed live in Settings -> Automation.
WAREHOUSE_STALE_DAYS=7

# Extra polling for parcels that are "out for delivery" (they move fastest).
# Runs in addition to the normal sync; can be changed in Settings -> Automation.
OFD_SYNC_ENABLED=true
OFD_SYNC_MINUTES=60

# Printed label size, in millimetres (defaults fit a 100x60 mm thermal label).
# LABEL_MODULE_MM is the width of one barcode module - lower it if a printed
# barcode will not scan on a low-resolution printer (0.25-0.33 is typical).
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=60
LABEL_MODULE_MM=0.33
